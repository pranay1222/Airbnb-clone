<% layout("layouts/boilerplate") %>
<body>
    <div class="row">
        <div class="col-6 offset-2">

            <h1>Edit Listing</h1>
        <form method="POST" action="/listings/<%= listings._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        
            <div class="mb-3">
                <label for="formFile" class="form-label">Title</label>
                <input name="listing[title]" value="<%= listings.title %>" class="form-control" required>
                <div class="invalid-feedback">
                    Please provide a title.
                </div>
                <div class="valid-feedback">
                    looks good.
                </div>
            </div>
            <div class="mb-3">
                <label for="formFile" class="form-label">Description</label>
                <textarea name="listing[description]" rows="4" cols="50" class="form-control" required><%= listings.description %></textarea>
                <div class="invalid-feedback">
                    Please provide a description.
                </div>
                <div class="valid-feedback">
                    looks good.
                </div>
            </div>
            <div class="mb-3">
                <label for="formFile" class="form-label">Current Image</label><br>
                <img src="<%= originalimageUrl %>" alt="Listing Image" style="max-width: 200px; max-height: 200px;">
            <div class="mb-3">
                <label for="formFile" class="form-label">Upload Listing Image</label>
                <input 
                name="listing[image]" 
                class="form-control"
                type="file" 
                >
            </div>
            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="formFile" class="form-label">Price</label>
                    <input name="listing[price]" value="<%= listings.price %>" type="number" class="form-control" required>
                    <div class="invalid-feedback">
                    Please provide a valid price.
                </div>
                <div class="valid-feedback">
                    looks good.
                </div>
                </div>
                <div class="mb-3 col-md-6">
                    <label for="formFile" class="form-label">Country</label>
                    <input name="listing[country]" value="<%= listings.country %>" class="form-control" required>
                    <div class="invalid-feedback">
                    Please provide a country name.
                </div>
                <div class="valid-feedback">
                    looks good.
                </div>
                </div>
            </div>
            <div class="mb-3">
                <label for="formFile" class="form-label">Location</label>
                <input name="listing[location]" value="<%= listings.location %>" class="form-control" required>
                <div class="invalid-feedback">
                    Please provide a location.
                </div>
                <div class="valid-feedback">
                    looks good.
                </div>
            </div>
            <div class="mb-3">
                    <label for="formFile" class="form-label">Category</label>
                    <input name="listing[category]" placeholder="Camping,Mountain.."  class="form-control" required>
                    <div class="invalid-feedback">
                        Please provide a location for your listing.
                    </div>
                    <div class="valid-feedback">
                        Looks good.
                    </div>
                </div>
            
            <button type="submit" class="btn btn-danger">Submit</button>
        </form>
        </div>
    </div>

</body>