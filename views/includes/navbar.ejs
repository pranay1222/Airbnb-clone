<style>
  .search-btn{
    background-color: #FF5A5F;
    border: none;
    color: white;
    border-radius: 25px;
    padding: 0rem 1rem 0rem 1rem;
  }
  .search-btn:hover{
    background-color: #FF787D;
    color: white;
  }
  .search-btn i{
    display: inline;
    margin-right: 0.5rem;
  }
  .inp-btn{
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
    font-size: 0.9rem;
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-solid fa-compass brand-logo"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>
      <div class="navbar-nav ms-auto">
        <form class="d-flex" role="search">
          <input class="form-control me-2 inp-btn" type="search" placeholder="Search destination" aria-label="Search"/>
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass "></i>Search</button>
        </form>
      </div>
      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Rest & Rove your palce</a>
        <% if(!currentUser){ %>
          <a class="nav-link" href="/signup"><b>Signup</b></a>
          <a class="nav-link" href="/login"><b>Login</b></a>
        <%}%>
        <% if(currentUser){%>
          <a class="nav-link" href="/logout">Logout</a>
        <%}%>
      </div>
    </div>
  </div>
</nav>